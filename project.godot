; Engine configuration file.
; Gerado para Godot 4.x — abra a pasta no Godot e ele atualiza o que precisar.

config_version=5

[application]

config/name="PipoTd"
config/description="Tower defense 3D medieval inspirado no Element TD 2"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

GameData="*res://scripts/autoload/game_data.gd"

[rendering]

renderer/rendering_method="forward_plus"
